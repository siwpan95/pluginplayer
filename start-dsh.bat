@echo off
rem DeepSeek Harness (dsh) Web UI launcher.
rem Mirror of deepseek-harness-master\start-dsh.bat (generated there by
rem gen_start_bat.py); kept next to run.bat so both launchers sit together.
rem GENERATED by build.py (make_launcher) -- edit the generator, not this file.
rem Web UI: http://127.0.0.1:3080
rem API key: C:\Users\13122\.dsh\.env (DEEPSEEK_API_KEY)
rem Deps are cached under npm-cache\_npx; the local mirror proxy covers any
rem cache-miss download -- this network needs it (node's undici cannot pull
rem large tarballs reliably here, urllib can).
rem Needs the dsh-app-boot junction-to-copy patch (WinError 448 workaround:
rem Tencent PC Manager blocks junction traversal). After any npx cache wipe
rem or dsh version bump, re-run fix_dsh_fallback_patch.py BEFORE this launcher.
set NODE_OPTIONS=
set npm_config_registry=http://127.0.0.1:8899
set npm_config_fetch_timeout=600000
set npm_config_fetch_retries=5
rem Start the local mirror proxy if it is not already listening.
powershell -NoProfile -Command "try { (New-Object Net.Sockets.TcpClient('127.0.0.1',8899)).Close() } catch { Start-Process -FilePath 'F:\Python314\python.exe' -ArgumentList 'C:\Users\13122\.dsh\npm_local_mirror.py' -WindowStyle Hidden }" >nul 2>&1
rem Wait until the proxy accepts connections (max 30s) so npx never races a
rem dead registry port and hangs silently with retry backoff.
powershell -NoProfile -Command "for ($i = 0; $i -lt 30; $i++) { try { (New-Object Net.Sockets.TcpClient('127.0.0.1',8899)).Close(); exit 0 } catch { Start-Sleep -Seconds 1 } }; exit 1" >nul 2>&1
echo dsh Web UI: http://127.0.0.1:3080 - Ctrl-C stops it
npx -y --no-audit --no-fund @deepseek-ai/dsh@0.1.0-rc.6 web --port 3080
set "DSH_RC=%ERRORLEVEL%"
if not "%DSH_RC%"=="0" (
  echo.
  echo [ERR] dsh exit code %DSH_RC%
  pause
)
exit /b %DSH_RC%
